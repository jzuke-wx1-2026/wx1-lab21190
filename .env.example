# Copy this file to .env and fill in optional API base URLs.
# Bearer token and org ID are configured in the dashboard Setup module (recommended).
# https://developer.webex.com/my-apps

# Optional — used if not configured via dashboard Setup
WEBEX_BEARER_TOKEN=your_bearer_token_here

# Organization ID (found in your token payload or Control Hub)
WEBEX_ORG_ID=your_org_id_here

# API base URLs (region-specific — us1 shown as default)
WXCC_ORG_BASE_URL=https://api.wxcc-us1.cisco.com/organization
WXCC_SEARCH_BASE_URL=https://api.wxcc-us1.cisco.com/search
WEBEX_API_BASE_URL=https://webexapis.com/v1
